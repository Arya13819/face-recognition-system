# Copy this file to .env and fill in real values for local development.
# On Render, set these as Environment Variables in the dashboard instead of a file.

# Flask session signing key — generate a random string for production
SECRET_KEY=change-this-to-a-random-secret-key

# Default admin account (created automatically on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Database — defaults to a local SQLite file if not set.
# For production, point this at a persistent Postgres instance, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///attendance.db
